# 高德地图 JS SDK 配置
# 申请地址：https://console.amap.com/dev/key/app
NEXT_PUBLIC_AMAP_KEY=your_amap_key_here
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_security_code_here

# API 服务地址
# 使用相对路径 /api/v1（与站点同源）：开发环境由 next.config.js rewrites 转发到 localhost:8000，
# 生产环境由 nginx 将 /api/v1 反向代理到后端，不要填 localhost，否则浏览器会请求访客自己的机器。
NEXT_PUBLIC_API_BASE_URL=/api/v1
