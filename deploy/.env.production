# =============================================================================
# UMCP 生产环境配置
# 复制为 .env 并填写所有必填项
# =============================================================================

# ===== 基础配置 =====
UMCP_JWT_SECRET=                                    # 必填：openssl rand -hex 32 生成
UMCP_LOG_LEVEL=INFO
UMCP_CORS_ORIGINS=https://你的前端域名

# ===== JWT 有效期 =====
UMCP_JWT_ACCESS_TTL=3600
UMCP_JWT_REFRESH_TTL=604800

# ===== PostgreSQL 数据库 =====
POSTGRES_USER=umcp
POSTGRES_PASSWORD=                                  # 必填：设置强密码
POSTGRES_DB=umcp

# ===== 限流中间件 =====
UMCP_RATE_LIMIT_ENABLED=true
UMCP_RATE_LIMIT_WINDOW=60
UMCP_RATE_LIMIT_MAX=100

# ===== 微信支付（生产环境必填） =====
WECHAT_APP_ID=                                      # 微信支付 AppID
WECHAT_MCH_ID=                                      # 微信商户号
WECHAT_API_V3_KEY=                                  # API V3 密钥
WECHAT_MCH_SERIAL_NO=                               # 商户证书序列号
WECHAT_PRIVATE_KEY_PATH=/app/certs/wechat_private.pem  # 证书挂载路径
WECHAT_NOTIFY_URL=https://你的域名/api/v1/escort/payments/callback

# ===== 互亿无线短信通知（必填） =====
IHUYI_SMS_API_ID=                                   # 互亿无线 API ID
IHUYI_SMS_API_KEY=                                  # 互亿无线 API KEY
IHUYI_SMS_SIGN=                                     # 短信签名

# ===== 插件 =====
UMCP_PLUGINS=escort_driving