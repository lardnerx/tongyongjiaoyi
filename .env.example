# ===== JWT 密钥（必填，至少 32 字节） =====
UMCP_JWT_SECRET=change-me-to-a-secure-random-string

# ===== 数据库连接（可选，不填使用内存仓储） =====
UMCP_DB_DSN=

# ===== JWT 有效期 =====
UMCP_JWT_ACCESS_TTL=3600
UMCP_JWT_REFRESH_TTL=604800

# ===== 服务监听 =====
UMCP_HOST=0.0.0.0
UMCP_PORT=8000

# ===== 日志级别 =====
UMCP_LOG_LEVEL=INFO

# ===== 跨域配置 =====
UMCP_CORS_ORIGINS=*

# ===== 认证缓存 TTL =====
UMCP_AUTH_CACHE_TTL=60

# ===== 严格认证模式（生产环境必须为 true） =====
# true：未注册手机号禁止登录、注册必须设置密码、未设密码账号拒绝登录、关闭免验证重置密码
# false：仅用于本地开发/演示（允许首次登录自动建号，存在任意手机号登录风险）
UMCP_AUTH_STRICT=true

# ===== 微信支付 V3（可选，不填使用 Mock 网关） =====
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
# 回调地址须为 https 公网域名（不得使用 IP，证书不匹配会导致回调失败）
WECHAT_NOTIFY_URL=https://jishi100.online/api/v1/escort/payments/callback

# ===== 限流中间件 =====
UMCP_RATE_LIMIT_ENABLED=false
UMCP_RATE_LIMIT_WINDOW=60
UMCP_RATE_LIMIT_MAX=100
UMCP_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# ===== 互亿无线短信通知（生产环境必填） =====
# 注册 https://www.ihuyi.com → 用户中心 → 验证码通知短信 → 获取 API ID / API KEY
IHUYI_SMS_API_ID=
IHUYI_SMS_API_KEY=
IHUYI_SMS_SIGN=

# ===== 阿里云短信通知（备选，与互亿无线二选一） =====
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ===== 插件列表 =====
UMCP_PLUGINS=escort_driving